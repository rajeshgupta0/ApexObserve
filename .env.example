NEXT_PUBLIC_ALERTING_API_URL=http://localhost:8084/api

# Production Overrides (defaults to localhost)
KAFKA_BROKERS=localhost:9092
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/apexobserve
FRONTEND_URL=http://localhost:3000
